# Tudo que começa com VITE_ é embutido no JavaScript que o navegador baixa.
# Por isso aqui NUNCA entra chave ou segredo: só endereços públicos.

# Endereço da API. Em desenvolvimento, deixe comentado: o Vite usa o proxy /api -> Flask.
# VITE_API_URL=https://sua-api.exemplo.com

# Endereço público do site (sem barra no fim). Com ele, o build gera sitemap.xml e as URLs
# absolutas de compartilhamento (og:image, og:url, canonical).
# VITE_SITE_URL=https://estudos-ia.exemplo.com
