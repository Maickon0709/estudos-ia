# Copie para .env (que NÃO vai pro Git) e preencha.
# Supabase > Project Settings > API
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=sua-chave-anon-publica
# NUNCA coloque a service_role key neste projeto nesta etapa.

# IA (Groq) > console.groq.com > API Keys
GROQ_API_KEY=sua-chave-da-groq
# Confira no console da Groq o nome de um modelo disponível hoje.
GROQ_MODEL=openai/gpt-oss-120b

# Busca na web (Tavily) > app.tavily.com. O plano gratuito dá 1.000 créditos/mês;
# cada pesquisa do projeto usa 2 créditos.
TAVILY_API_KEY=sua-chave-do-tavily

# YouTube Data API v3 (opcional) > Google Cloud Console > APIs e serviços.
# Sem ela, vídeos e playlists saem marcados como "nao_verificado".
YOUTUBE_API_KEY=sua-chave-do-youtube

# Cookies da sessão só em HTTPS (padrão). Se o navegador recusar em http://localhost, use 0.
# COOKIE_SEGURO=1

# Limite de uso por usuário por dia (zera à meia-noite de Brasília). Opcional; estes são os padrões.
# LIMITE_CHAT_DIA=60
# LIMITE_IA_DIA=30
# LIMITE_PESQUISA_DIA=6
